<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_ghl_calendar_sync" model="ir.cron">
            <field name="name">GHL Calendar Sync: sincronizar citas</field>
            <field name="model_id" ref="model_ghl_calendar_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_all()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_ghl_sede_sync" model="ir.cron">
            <field name="name">GHL Calendar Sync: sincronizar sedes (reparto)</field>
            <field name="model_id" ref="model_ghl_sede"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_all()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
