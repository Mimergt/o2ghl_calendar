<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ghl_sede_form" model="ir.ui.view">
        <field name="name">ghl.sede.form</field>
        <field name="model">ghl.sede</field>
        <field name="arch" type="xml">
            <form string="Sede GHL">
                <header>
                    <button name="action_test_connection" type="object"
                            string="Probar conexión" class="btn-secondary"/>
                    <field name="last_sync_status" widget="badge"
                           decoration-success="last_sync_status == 'ok'"
                           decoration-danger="last_sync_status == 'error'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Empresa y calendario">
                            <field name="company_id"/>
                            <field name="ghl_calendar_id"/>
                        </group>
                        <group string="Credenciales GHL">
                            <field name="ghl_api_key" password="True"/>
                            <field name="ghl_location_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Regla de reparto">
                            <field name="morning_cutoff_time" widget="float_time"/>
                            <field name="fallback_user_id"/>
                        </group>
                        <group string="Round robin (interno)">
                            <field name="last_assigned_morning_id" readonly="1"/>
                            <field name="last_assigned_afternoon_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Ventana de sincronización">
                            <field name="sync_window_days_past"/>
                            <field name="sync_window_days_future"/>
                        </group>
                        <group string="Estado">
                            <field name="active"/>
                            <field name="last_sync_datetime" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Vendedores">
                            <p class="text-muted">
                                Marca los turnos en los que cada vendedor participa del
                                reparto (round robin). Un vendedor puede estar marcado en
                                ambas columnas si trabaja mañana y tarde.
                            </p>
                            <field name="vendor_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="user_id"/>
                                    <field name="works_morning" string="Mañana"/>
                                    <field name="works_afternoon" string="Tarde"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Log última corrida">
                            <field name="last_sync_log" readonly="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ghl_sede_list" model="ir.ui.view">
        <field name="name">ghl.sede.list</field>
        <field name="model">ghl.sede</field>
        <field name="arch" type="xml">
            <list string="Sedes GHL">
                <field name="name"/>
                <field name="company_id"/>
                <field name="ghl_calendar_id"/>
                <field name="vendor_count" string="Vendedores activos"/>
                <field name="fallback_user_id"/>
                <field name="last_sync_status" widget="badge"
                       decoration-success="last_sync_status == 'ok'"
                       decoration-danger="last_sync_status == 'error'"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_ghl_sede" model="ir.actions.act_window">
        <field name="name">GHL Calendar Sync - Sedes</field>
        <field name="res_model">ghl.sede</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ghl_calendar_sync_root"
              name="GHL2ODOO"
              sequence="90"
              groups="base.group_system"
              web_icon="ghl_calendar_sync,static/description/icon.png"/>
    <menuitem id="menu_ghl_sede"
              name="Sedes"
              parent="menu_ghl_calendar_sync_root"
              action="action_ghl_sede"
              sequence="20"/>
</odoo>
